<odoo>
    <record id="view_enumerator_config_tree" model="ir.ui.view">
        <field name="name">view_enumerator_config_tree</field>
        <field name="model">g2p.enumerator</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Field officer" />
                <field name="enumerator_user_id" string="Field officer ID" />
                <field name="data_collection_date" />
                <field name="enum_latitude" />
                <field name="enum_longitude" />
                <field name="enum_altitude" />
                <field name="enum_accuracy" />
            </tree>
        </field>
    </record>
    <record id="view_enumerator_config_form" model="ir.ui.view">
        <field name="name">view_enumerator_config_form</field>
        <field name="model">g2p.enumerator</field>
        <field name="arch" type="xml">
            <form>
                <group string="Field officer details">
                    <field name="name" string="Field officer Name" />
                    <field name="enumerator_user_id" string="Field officer ID" />
                    <!-- <field name="data_collection_date" /> -->
                </group>
                <group string="Field officer Location">
                    <field name="enum_latitude" />
                    <field name="enum_longitude" />
                    <field name="enum_altitude" />
                    <field name="enum_accuracy" />
                </group>
            </form>
        </field>
    </record>

    <record id="action_enumerator_action" model="ir.actions.act_window">
        <field name="name">Field officers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">g2p.enumerator</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_enumerator_config_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No field officers found!
            </p>
            <p>
                The system will automatically create a field officer record when you publish a draft submitted from the portal.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_enumerator_config"
        name="Field officers"
        action="action_enumerator_action"
        parent="g2p_registry_base.g2p_configuration_menu_root"
        sequence="50"
    />

</odoo>
