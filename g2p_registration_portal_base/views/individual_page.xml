                                                    id="beneficiary_submit"
                                                    type="button"
                                                    onclick="validateForm(true);"
                                                    class="btn btn-primary create-new"
                                                >
                                                    Submit
                                                </button>


                                            </div>
                                            <script
                                                src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"
                                            />
                                            <script
                                                type="text/javascript"
                                                src="/g2p_registration_portal_base/static/src/js/member_form.js"
                                            />

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
